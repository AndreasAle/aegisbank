# Copy to .env (which is git-ignored) and adjust. Everything here is for the
# local simulation only. Do not reuse these values anywhere else.

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=aegisbank
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-local-postgres
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
API_PORT=8080
DASHBOARD_PORT=8081

# HMAC key for access tokens. At least 32 bytes. Generate your own, e.g.:
#   openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-at-least-32-random-bytes-0000000000

# --- Demo dataset (Development only; refused when the environment is Production)
SEED_ENABLED=true
# Passwords for the fictional demo users created by the seed:
#   ops.admin (Admin), audit.viewer (Auditor), ratna / bima / sari (Customer)
SEED_ADMIN_PASSWORD=Demo-Admin-2026!
SEED_AUDITOR_PASSWORD=Demo-Auditor-2026!
SEED_CUSTOMER_PASSWORD=Demo-Customer-2026!

# --- Rate limiting ----------------------------------------------------------
# Set RATE_LIMITING_ENABLED=false only while running the k6 load test.
RATE_LIMITING_ENABLED=true
RATE_LIMIT_PER_MINUTE=600

# --- k6 load test (docker compose --profile bench run --rm k6) ---------------
LOAD_VUS=32
LOAD_DURATION=60s
LOAD_WARMUP=15s
