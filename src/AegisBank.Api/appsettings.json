{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "aegisbank",
    "Audience": "aegisbank-api",
    "SigningKey": "",
    "AccessTokenMinutes": 10
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Transfers": {
    "MaxAttempts": 4,
    "BaseRetryDelayMilliseconds": 20,
    "IdempotencyRetentionHours": 24
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitPerMinute": 600,
    "AuthPermitPerMinute": 10
  },
  "Seed": {
    "Enabled": false
  }
}
