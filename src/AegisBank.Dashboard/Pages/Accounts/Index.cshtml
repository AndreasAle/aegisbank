@page
@model AegisBank.Dashboard.Pages.Accounts.IndexModel
@{
    ViewData["Title"] = "Accounts";
}

@if (Model.Error is not null)
{
    <div class="note bad">@Model.Error</div>
}

<section class="panel">
    <form method="get" class="filters">
        <div class="field grow">
            <label for="q">Search</label>
            <input id="q" name="Q" type="search" value="@Model.Q" placeholder="Account number, account name or customer" maxlength="100" />
        </div>
        <div class="field">
            <label for="status">Status</label>
            <select id="status" name="Status">
                <option value="">All</option>
                @foreach (var s in new[] { "Active", "Frozen", "Closed" })
                {
                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                }
            </select>
        </div>
        <button type="submit" class="btn">Apply</button>
        <a class="btn" asp-page="/Accounts/Index">Reset</a>
        @if (Model.IsAdmin)
        {
            <a class="btn primary" asp-page="/Accounts/New">Open account</a>
        }
    </form>

    @if (Model.Result.Items.Count == 0)
    {
        <div class="empty">No accounts match the current filter.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="grid">
                <thead>
                <tr>
                    <th><a class="sorted" href="@Model.SortUrl("accountNumber")">Account@(Model.SortMark("accountNumber"))</a></th>
                    <th>Name</th>
                    <th>Customer</th>
                    <th><a href="@Model.SortUrl("status")">Status@(Model.SortMark("status"))</a></th>
                    <th class="num"><a href="@Model.SortUrl("balance")">Balance (Rp)@(Model.SortMark("balance"))</a></th>
                    <th><a href="@Model.SortUrl("createdAt")">Opened@(Model.SortMark("createdAt"))</a></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var a in Model.Result.Items)
                {
                    <tr>
                        <td><a class="mono" asp-page="/Accounts/Details" asp-route-id="@a.Id">@a.AccountNumber</a></td>
                        <td>@a.Name</td>
                        <td>@a.CustomerName <span class="dim mono">@a.CustomerNumber</span></td>
                        <td><span class="st @Ui.StatusClass(a.Status)">@a.Status</span></td>
                        <td class="num">@Ui.Amount(a.AvailableBalanceMinorUnits)</td>
                        <td class="nowrap">@a.CreatedAt.ToString("yyyy-MM-dd")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, Model.Result.PageSize, Model.PageUrl)" />
</section>
