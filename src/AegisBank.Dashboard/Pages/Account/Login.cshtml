@page
@model AegisBank.Dashboard.Pages.Account.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in · AegisBank Console</title>
    <link rel="stylesheet" href="~/css/console.css" asp-append-version="true" />
</head>
<body>
<div class="signin">
    <section class="signin-form">
        <div class="brand">
            <div class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <div class="brand-name">Aegis<span>Bank</span></div>
        </div>
        <h1>Welcome back</h1>
        <div class="dim">Sign in to the operations console. Staff accounts only.</div>

        <form method="post" autocomplete="off">
            @if (Model.Failed)
            {
                <div class="note bad" role="alert">The username or password is incorrect, or the account is locked.</div>
            }
            <div class="field">
                <label asp-for="Input.Username">Username</label>
                <input asp-for="Input.Username" type="text" autocomplete="username" autofocus />
                <span asp-validation-for="Input.Username" class="field-error"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="field-error"></span>
            </div>
            <button type="submit" class="btn primary">Sign in</button>
        </form>

        <div class="signin-foot">
            Simulation environment. No real funds, customers or banking networks are involved.
        </div>
    </section>
    <section class="signin-side">
        <h2>Transaction engine, ledger and controls for a simulated bank.</h2>
        <ul>
            <li>Transfers are decided by a native C++ engine and posted in a single database transaction.</li>
            <li>Every movement of funds is a balanced double-entry journal that cannot be edited afterwards.</li>
            <li>Stored balances are reconciled against the ledger on demand.</li>
        </ul>
    </section>
</div>
</body>
</html>
