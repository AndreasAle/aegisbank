@page
@model AegisBank.Dashboard.Pages.Transfers.IndexModel
@{
    ViewData["Title"] = "Transaction history";
}

@if (Model.Error is not null)
{
    <div class="note bad">@Model.Error</div>
}

<section class="panel">
    <form method="get" class="filters">
        <div class="field grow">
            <label for="reference">Reference starts with</label>
            <input id="reference" name="Reference" type="search" class="mono" value="@Model.Reference" placeholder="TRF-" maxlength="32" />
        </div>
        <div class="field">
            <label for="status">Status</label>
            <select id="status" name="Status">
                <option value="">All</option>
                @foreach (var s in new[] { "Completed", "Rejected" })
                {
                    <option value="@s" selected="@(Model.Status == s)">@s</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="kind">Type</label>
            <select id="kind" name="Kind">
                <option value="">All</option>
                @foreach (var k in new[] { "Internal", "OpeningDeposit", "Reversal" })
                {
                    <option value="@k" selected="@(Model.Kind == k)">@Ui.KindLabel(k)</option>
                }
            </select>
        </div>
        <button type="submit" class="btn">Apply</button>
        <a class="btn" asp-page="/Transfers/Index">Reset</a>
    </form>

    @if (Model.Result.Items.Count == 0)
    {
        <div class="empty">No transactions match the current filter.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="grid">
                <thead>
                <tr>
                    <th><a href="@Model.SortUrl("createdAt")">Time (UTC)@(Model.SortMark("createdAt"))</a></th>
                    <th><a href="@Model.SortUrl("reference")">Reference@(Model.SortMark("reference"))</a></th>
                    <th>Type</th>
                    <th>From</th>
                    <th>To</th>
                    <th class="num"><a href="@Model.SortUrl("amount")">Amount (Rp)@(Model.SortMark("amount"))</a></th>
                    <th>Status</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var t in Model.Result.Items)
                {
                    <tr>
                        <td class="nowrap">@Ui.Time(t.CreatedAt)</td>
                        <td><a class="mono" asp-page="/Transfers/Details" asp-route-id="@t.Id">@t.ReferenceNumber</a></td>
                        <td>@Ui.KindLabel(t.Kind)</td>
                        <td class="mono">@t.SourceAccountNumber</td>
                        <td class="mono">@t.DestinationAccountNumber</td>
                        <td class="num">@Ui.Amount(t.AmountMinorUnits)</td>
                        <td>
                            <span class="st @Ui.StatusClass(t.Status)">@t.Status</span>
                            @if (t.FailureCode is not null)
                            {
                                <span class="dim mono">@t.FailureCode</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, Model.Result.PageSize, Model.PageUrl)" />
</section>
