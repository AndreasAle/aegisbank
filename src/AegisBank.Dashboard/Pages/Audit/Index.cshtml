@page
@model AegisBank.Dashboard.Pages.Audit.IndexModel
@{
    ViewData["Title"] = "Audit log";
}

<section class="panel">
    <form method="get" class="filters">
        <div class="field">
            <label for="action">Category</label>
            <select id="action" name="Action">
                @foreach (var (value, label) in AegisBank.Dashboard.Pages.Audit.IndexModel.Categories)
                {
                    <option value="@value" selected="@(Model.Action == value)">@label</option>
                }
            </select>
        </div>
        <button type="submit" class="btn">Apply</button>
    </form>

    @if (Model.Result.Items.Count == 0)
    {
        <div class="empty">No audit events match the current filter.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="grid">
                <thead>
                <tr><th>Time (UTC)</th><th>Actor</th><th>Action</th><th>Entity</th><th>Details</th><th>Correlation</th></tr>
                </thead>
                <tbody>
                @foreach (var a in Model.Result.Items)
                {
                    var kind = a.Action.Contains("failed") || a.Action.Contains("denied") || a.Action.Contains("reuse") || a.Action.Contains("lockout")
                        ? "bad" : a.Action.Contains("rejected") ? "warn" : "muted";
                    <tr>
                        <td class="nowrap">@Ui.Time(a.CreatedAt)</td>
                        <td>@(a.ActorUsername ?? "—")</td>
                        <td><span class="st @kind mono">@a.Action</span></td>
                        <td>@a.EntityType <div class="dim mono">@a.EntityId</div></td>
                        <td class="wrap"><pre class="meta">@(a.Metadata == "{}" ? "" : a.Metadata)</pre></td>
                        <td class="dim mono">@(a.CorrelationId is { Length: > 12 } c ? c[..12] + "…" : a.CorrelationId)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    <partial name="_Pager" model="new PagerModel(Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, Model.Result.PageSize, Model.PageUrl)" />
    <div class="panel-foot"><span>Audit records are append-only. The database rejects updates and deletes on this table.</span></div>
</section>
