@model PagerModel
<div class="panel-foot">
    <span>
        @if (Model.TotalCount == 0)
        {
            <text>No rows</text>
        }
        else
        {
            <text>@Ui.Count(Model.First)–@Ui.Count(Model.Last) of @Ui.Count(Model.TotalCount)</text>
        }
    </span>
    <span class="pager">
        @if (Model.Page > 1)
        {
            <a href="@Model.Url(Model.Page - 1)">Previous</a>
        }
        else
        {
            <span class="off">Previous</span>
        }
        <span>Page @Model.Page of @Math.Max(1, Model.TotalPages)</span>
        @if (Model.Page < Model.TotalPages)
        {
            <a href="@Model.Url(Model.Page + 1)">Next</a>
        }
        else
        {
            <span class="off">Next</span>
        }
    </span>
</div>
