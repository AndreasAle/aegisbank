@using AegisBank.Infrastructure.Web
@{
    var path = Context.Request.Path.Value ?? "/";
    string On(string prefix, bool exact = false) =>
        (exact ? path == prefix || path == "/Index" : path.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) ? "on" : "";
    var username = User.FindFirst(AegisClaims.Username)?.Value;
    var role = User.FindFirst(AegisClaims.Role)?.Value;
    var initial = string.IsNullOrEmpty(username) ? "?" : username.Substring(0, 1).ToUpperInvariant();
    var notice = TempData["Notice"] as string;
    var noticeKind = TempData["NoticeKind"] as string ?? "ok";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>@ViewData["Title"] · AegisBank Console</title>
    <link rel="stylesheet" href="~/css/console.css" asp-append-version="true" />
</head>
<body>
<div class="shell">
    <aside class="side">
        <div class="brand">
            <div class="logo"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg></div>
            <div>
                <div class="brand-name">Aegis<span>Bank</span></div>
                <div class="brand-sub">Operations console</div>
            </div>
        </div>
        <nav class="nav" aria-label="Primary">
            <div class="nav-group">Monitor</div>
            <a class="@On("/", true)" asp-page="/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/></svg>Overview</a>
            <a class="@On("/Monitoring")" asp-page="/Monitoring/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12h4l3-8 4 16 3-8h4"/></svg>System monitoring</a>
            <div class="nav-group">Banking</div>
            <a class="@On("/Accounts")" asp-page="/Accounts/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="3"/><path d="M3 10h18"/><circle cx="16.5" cy="15" r="1"/></svg>Accounts</a>
            <a class="@(path.StartsWith("/Transfers/New", StringComparison.OrdinalIgnoreCase) ? "on" : "")" asp-page="/Transfers/New"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 3L10 14"/><path d="M21 3l-7 18-4-7-7-4z"/></svg>Transfer simulator</a>
            <a class="@(path.StartsWith("/Transfers", StringComparison.OrdinalIgnoreCase) && !path.StartsWith("/Transfers/New", StringComparison.OrdinalIgnoreCase) ? "on" : "")" asp-page="/Transfers/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/></svg>Transaction history</a>
            <div class="nav-group">Control</div>
            <a class="@On("/Ledger")" asp-page="/Ledger/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 012-2h13v17H6a2 2 0 00-2 2z"/><path d="M4 19V5"/></svg>Ledger explorer</a>
            <a class="@On("/Audit")" asp-page="/Audit/Index"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg>Audit log</a>
        </nav>
        <div class="who">
            <div class="avatar" aria-hidden="true">@initial</div>
            <div class="who-text">
                <div class="who-name">@username</div>
                <div class="who-role">@role</div>
            </div>
            <form method="post" asp-page="/Account/Logout">
                <button type="submit" title="Sign out" aria-label="Sign out"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg></button>
            </form>
        </div>
    </aside>
    <div class="main">
        <header class="top">
            <div>
                @if (ViewData["Crumb"] is string crumb)
                {
                    <div class="crumb">@crumb</div>
                }
                <h1>@ViewData["Title"]</h1>
            </div>
            <div class="top-meta">
                <span class="clock">@DateTime.UtcNow.ToString("dd MMM yyyy, HH:mm") UTC</span>
                <span class="sim-tag" title="No real money or banking network is involved">Simulation</span>
            </div>
        </header>
        <main class="content">
            @if (!string.IsNullOrEmpty(notice))
            {
                <div class="note @noticeKind" role="status">@notice</div>
            }
            @RenderBody()
        </main>
    </div>
</div>
</body>
</html>
