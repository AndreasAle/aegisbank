@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Overview";
    var o = Model.Overview;
    var c = Model.Chart;
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    // Razor reserves the <text> tag, so SVG text elements are emitted through this helper.
    Microsoft.AspNetCore.Html.IHtmlContent SvgText(double x, double y, string anchor, string label) =>
        Html.Raw($"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(label)}</text>");
    var successRate = o.TransferCount == 0 ? (double?)null : o.CompletedTransferCount * 100.0 / o.TransferCount;
}

<div class="hero">
    <section class="balance-card">
        <div class="balance-top">
            <div class="balance-label">Total customer balance</div>
            <div class="balance-value">@Ui.Money(o.TotalCustomerBalanceMinorUnits)</div>
        </div>
        <div class="balance-meta">
            <div>Vault cash<strong>@Ui.Money(o.VaultCashBalanceMinorUnits)</strong></div>
            <div>Customer accounts<strong>@Ui.Count(o.CustomerAccountCount) (@Ui.Count(o.ActiveAccountCount) active)</strong></div>
            <div>Customers<strong>@Ui.Count(o.CustomerCount)</strong></div>
        </div>
    </section>
    <div class="stat-grid">
        <div class="stat">
            <div class="stat-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13"/><circle cx="3.5" cy="6" r="1"/><circle cx="3.5" cy="12" r="1"/><circle cx="3.5" cy="18" r="1"/></svg></div>
            <div class="stat-label">Transactions</div>
            <div class="stat-value">@Ui.Count(o.TransferCount)</div>
            <div class="stat-note">all kinds, all time</div>
        </div>
        <div class="stat">
            <div class="stat-ico g"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
            <div class="stat-label">Completed</div>
            <div class="stat-value">@Ui.Count(o.CompletedTransferCount)</div>
            <div class="stat-note">@Ui.Money(o.CompletedAmountMinorUnits)</div>
        </div>
        <div class="stat">
            <div class="stat-ico r"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></div>
            <div class="stat-label">Rejected</div>
            <div class="stat-value">@Ui.Count(o.RejectedTransferCount)</div>
            <div class="stat-note">@(successRate is { } r ? r.ToString("0.0", CultureInfo.InvariantCulture) + "% completed" : "no transactions yet")</div>
        </div>
        <div class="stat">
            <div class="stat-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="14" rx="3"/><path d="M3 10h18"/></svg></div>
            <div class="stat-label">Active accounts</div>
            <div class="stat-value">@Ui.Count(o.ActiveAccountCount)</div>
            <div class="stat-note">of @Ui.Count(o.CustomerAccountCount) customer accounts</div>
        </div>
    </div>
</div>

<div class="cols">
    <section class="panel">
        <div class="panel-head">
            <h2>Transactions per day</h2>
            <div class="legend"><span><i class="l-ok"></i>Completed</span><span><i class="l-bad"></i>Rejected</span></div>
        </div>
        <div class="panel-body">
            <svg class="chart" viewBox="0 0 @c.Width @c.Height" role="img" aria-label="Transactions per day, last 14 days">
                @foreach (var t in c.Ticks)
                {
                    <line class="gridline" x1="@c.PlotLeft" x2="@(c.PlotLeft + c.PlotWidth)" y1="@F(t.Y)" y2="@F(t.Y)" />
                    @SvgText(c.PlotLeft - 6, t.Y + 3.5, "end", t.Label)
                }
                @foreach (var b in c.Bars)
                {
                    <g>
                        <title>@b.Tooltip</title>
                        @if (b.CompletedHeight > 0)
                        {
                            <rect class="bar-ok" x="@F(b.X)" y="@F(b.CompletedY)" width="@F(b.Width)" height="@F(b.CompletedHeight)" />
                        }
                        @if (b.RejectedHeight > 0)
                        {
                            <rect class="bar-bad" x="@F(b.X)" y="@F(b.RejectedY)" width="@F(b.Width)" height="@F(b.RejectedHeight)" />
                        }
                        @if (b.ShowLabel)
                        {
                            @SvgText(b.X + b.Width / 2, c.PlotTop + c.PlotHeight + 15, "middle", b.Label)
                        }
                    </g>
                }
                <line class="axis" x1="@c.PlotLeft" x2="@(c.PlotLeft + c.PlotWidth)" y1="@(c.PlotTop + c.PlotHeight)" y2="@(c.PlotTop + c.PlotHeight)" />
            </svg>
        </div>
        <div class="panel-foot"><span>Last 14 days, UTC. Counts include opening deposits and reversals.</span></div>
    </section>

    <section class="panel">
        <div class="panel-head"><h2>Daily totals</h2></div>
        <div class="table-wrap">
            <table class="grid">
                <thead><tr><th>Day</th><th class="num">Completed</th><th class="num">Rejected</th><th class="num">Amount (Rp)</th></tr></thead>
                <tbody>
                @foreach (var d in o.DailyVolume.Reverse().Take(7))
                {
                    <tr>
                        <td class="nowrap">@Ui.Day(d.Day)</td>
                        <td class="num">@Ui.Count(d.CompletedCount)</td>
                        <td class="num">@Ui.Count(d.RejectedCount)</td>
                        <td class="num">@Ui.Amount(d.CompletedAmountMinorUnits)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<section class="panel">
    <div class="panel-head">
        <h2>Recent activity</h2>
        <a asp-page="/Transfers/Index">View all</a>
    </div>
    @if (o.RecentTransfers.Count == 0)
    {
        <div class="empty">No transactions have been posted yet.</div>
    }
    else
    {
        <ul class="feed">
        @foreach (var t in o.RecentTransfers)
        {
            var cls = t.Status == "Rejected" ? "bad" : (t.Kind == "OpeningDeposit" ? "in" : "");
            <li>
                <a class="tx" asp-page="/Transfers/Details" asp-route-id="@t.Id">
                    <span class="tx-ico @cls">
                        @if (t.Status == "Rejected")
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
                        }
                        else if (t.Kind == "OpeningDeposit")
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5"/><path d="M6 11l6-6 6 6"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
                        }
                    </span>
                    <span>
                        <div class="tx-title">@Ui.KindLabel(t.Kind)</div>
                        <div class="tx-sub"><span class="mono">@t.SourceAccountNumber</span> → <span class="mono">@t.DestinationAccountNumber</span> · <span class="mono">@t.ReferenceNumber</span></div>
                    </span>
                    <span class="tx-right">
                        <div class="tx-amount @cls">@Ui.Money(t.AmountMinorUnits)</div>
                        <div class="tx-time"><span class="st @Ui.StatusClass(t.Status)">@t.Status</span> @Ui.Time(t.CreatedAt)</div>
                    </span>
                </a>
            </li>
        }
        </ul>
    }
</section>
