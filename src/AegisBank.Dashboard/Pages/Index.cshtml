@page
@model IndexModel
@using System.Globalization
@{
    ViewData["Title"] = "Overview";
    var o = Model.Overview;
    var c = Model.Chart;
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);
    // Razor reserves the <text> tag, so SVG text elements are emitted through this helper.
    Microsoft.AspNetCore.Html.IHtmlContent SvgText(double x, double y, string anchor, string label) =>
        Html.Raw($"<text x=\"{F(x)}\" y=\"{F(y)}\" text-anchor=\"{anchor}\">{System.Net.WebUtility.HtmlEncode(label)}</text>");
    var successRate = o.TransferCount == 0 ? (double?)null : o.CompletedTransferCount * 100.0 / o.TransferCount;
}

<div class="figures">
    <div class="figure">
        <div class="figure-label">Customer accounts</div>
        <div class="figure-value">@Ui.Count(o.CustomerAccountCount)</div>
        <div class="figure-note">@Ui.Count(o.ActiveAccountCount) active · @Ui.Count(o.CustomerCount) customers</div>
    </div>
    <div class="figure">
        <div class="figure-label">Total customer balance</div>
        <div class="figure-value small">@Ui.Money(o.TotalCustomerBalanceMinorUnits)</div>
        <div class="figure-note">Vault cash @Ui.Money(o.VaultCashBalanceMinorUnits)</div>
    </div>
    <div class="figure">
        <div class="figure-label">Transactions</div>
        <div class="figure-value">@Ui.Count(o.TransferCount)</div>
        <div class="figure-note">all kinds, all time</div>
    </div>
    <div class="figure">
        <div class="figure-label">Completed</div>
        <div class="figure-value">@Ui.Count(o.CompletedTransferCount)</div>
        <div class="figure-note">@Ui.Money(o.CompletedAmountMinorUnits)</div>
    </div>
    <div class="figure">
        <div class="figure-label">Rejected</div>
        <div class="figure-value">@Ui.Count(o.RejectedTransferCount)</div>
        <div class="figure-note">@(successRate is { } r ? r.ToString("0.0", CultureInfo.InvariantCulture) + "% completed" : "no transactions yet")</div>
    </div>
</div>

<div class="cols">
    <section class="panel">
        <div class="panel-head">
            <h2>Transactions per day</h2>
            <div class="legend"><span><i class="l-ok"></i>Completed</span><span><i class="l-bad"></i>Rejected</span></div>
        </div>
        <div class="panel-body">
            <svg class="chart" viewBox="0 0 @c.Width @c.Height" role="img" aria-label="Transactions per day, last 14 days">
                @foreach (var t in c.Ticks)
                {
                    <line class="gridline" x1="@c.PlotLeft" x2="@(c.PlotLeft + c.PlotWidth)" y1="@F(t.Y)" y2="@F(t.Y)" />
                    @SvgText(c.PlotLeft - 6, t.Y + 3.5, "end", t.Label)
                }
                @foreach (var b in c.Bars)
                {
                    <g>
                        <title>@b.Tooltip</title>
                        @if (b.CompletedHeight > 0)
                        {
                            <rect class="bar-ok" x="@F(b.X)" y="@F(b.CompletedY)" width="@F(b.Width)" height="@F(b.CompletedHeight)" />
                        }
                        @if (b.RejectedHeight > 0)
                        {
                            <rect class="bar-bad" x="@F(b.X)" y="@F(b.RejectedY)" width="@F(b.Width)" height="@F(b.RejectedHeight)" />
                        }
                        @if (b.ShowLabel)
                        {
                            @SvgText(b.X + b.Width / 2, c.PlotTop + c.PlotHeight + 15, "middle", b.Label)
                        }
                    </g>
                }
                <line class="axis" x1="@c.PlotLeft" x2="@(c.PlotLeft + c.PlotWidth)" y1="@(c.PlotTop + c.PlotHeight)" y2="@(c.PlotTop + c.PlotHeight)" />
            </svg>
        </div>
        <div class="panel-foot"><span>Last 14 days, UTC. Counts include opening deposits and reversals.</span></div>
    </section>

    <section class="panel">
        <div class="panel-head"><h2>Daily totals</h2></div>
        <div class="table-wrap">
            <table class="grid">
                <thead><tr><th>Day</th><th class="num">Completed</th><th class="num">Rejected</th><th class="num">Amount (Rp)</th></tr></thead>
                <tbody>
                @foreach (var d in o.DailyVolume.Reverse().Take(7))
                {
                    <tr>
                        <td>@Ui.Day(d.Day)</td>
                        <td class="num">@Ui.Count(d.CompletedCount)</td>
                        <td class="num">@Ui.Count(d.RejectedCount)</td>
                        <td class="num">@Ui.Amount(d.CompletedAmountMinorUnits)</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</div>

<section class="panel">
    <div class="panel-head">
        <h2>Recent activity</h2>
        <a asp-page="/Transfers/Index">All transactions</a>
    </div>
    @if (o.RecentTransfers.Count == 0)
    {
        <div class="empty">No transactions have been posted yet.</div>
    }
    else
    {
        <div class="table-wrap">
            <table class="grid">
                <thead>
                <tr><th>Time (UTC)</th><th>Reference</th><th>Type</th><th>From</th><th>To</th><th class="num">Amount (Rp)</th><th>Status</th></tr>
                </thead>
                <tbody>
                @foreach (var t in o.RecentTransfers)
                {
                    <tr>
                        <td class="nowrap">@Ui.Time(t.CreatedAt)</td>
                        <td><a class="mono" asp-page="/Transfers/Details" asp-route-id="@t.Id">@t.ReferenceNumber</a></td>
                        <td>@Ui.KindLabel(t.Kind)</td>
                        <td class="mono">@t.SourceAccountNumber</td>
                        <td class="mono">@t.DestinationAccountNumber</td>
                        <td class="num">@Ui.Amount(t.AmountMinorUnits)</td>
                        <td><span class="st @Ui.StatusClass(t.Status)">@t.Status</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
