{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Auth": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "Benchmarks": {
    "SummaryPath": ""
  },
  "Seed": {
    "Enabled": false
  }
}
